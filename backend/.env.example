# Copy to the repo root as .env (or to backend/.env). Never commit real values.
CALA_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=
# Comma-separated origins allowed by CORS, e.g. http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
# Access code required in the X-Access-Code header for POST /api/audit
AUDIT_ACCESS_CODE=
